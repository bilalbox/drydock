{
  "name": "Drydock",
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:4": {}
  },
  // Smallest Codespaces machine that qualifies is standardLinux32gb
  // (4 cores, 16 GB RAM, 32 GB storage). The 2-core machine is excluded.
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb",
    "storage": "32gb"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "Drydock",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "otherPortsAttributes": {
    "onAutoForward": "ignore"
  },
  "postStartCommand": "sh .devcontainer/up.sh",
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
